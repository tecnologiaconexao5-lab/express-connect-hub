# ============================================================
# SUPABASE (Obrigatorio)
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL base da aplicacao
VITE_APP_URL=http://localhost:8800

# ============================================================
# MAPBOX (Obrigatorio para calculo de distancia)
# ============================================================
VITE_MAPBOX_ACCESS_TOKEN=pk.your.Mapbox.public.token.here
VITE_MAPBOX_TOKEN=pk.your.Mapbox.public.token.here

# ============================================================
# EVOLUTION API (WhatsApp)
# ============================================================
VITE_EVOLUTION_API_URL=http://127.0.0.1:8080
VITE_EVOLUTION_API_KEY=your-evolution-api-key
VITE_EVOLUTION_INSTANCE_NAME=recrutamento-conexao-express
VITE_EVOLUTION_SERVER_URL=http://127.0.0.1:8080
VITE_EVOLUTION_INSTANCE=recrutamento-conexao-express

# ============================================================
# WHATSAPP HOMOLOGACAO / PRODUCAO ASSISTIDA
# ============================================================
VITE_WHATSAPP_HOMOLOG_ENABLED=false
VITE_WHATSAPP_HOMOLOG_ALLOWLIST=5511999999999,5511888888888
VITE_COMUNICACAO_PRODUCAO_ASSISTIDA=false
VITE_WHATSAPP_PRODUCAO_ENABLED=false
VITE_WHATSAPP_ALLOWED_SETORES=operacional
VITE_WHATSAPP_DAILY_LIMIT=10
VITE_WHATSAPP_ALLOWED_HOURS_START=08:00
VITE_WHATSAPP_ALLOWED_HOURS_END=18:00

# ============================================================
# MODO DOS CONECTORES
# ============================================================
VITE_ZOHO_MODE=homologacao
VITE_WHATSAPP_MODE=homologacao

# ============================================================
# N8N (Automacao)
# ============================================================
VITE_N8N_API_URL=http://localhost:5678
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/recrutamento-whatsapp
VITE_N8N_WEBHOOK_WHATSAPP_RECRUTAMENTO=http://localhost:5678/webhook/recrutamento-whatsapp
VITE_N8N_WEBHOOK_ZOHO_EMAIL=http://localhost:5678/webhook/zoho-email
VITE_N8N_WEBHOOK_COMERCIAL_AUTOMACAO=http://localhost:5678/webhook/comercial-automacao
VITE_N8N_WEBHOOK_OS=http://localhost:5678/webhook/os-whatsapp
VITE_N8N_WEBHOOK_OS_WHATSAPP_URL=http://localhost:5678/webhook/os-whatsapp

# ============================================================
# IA - CHAVES NO BACKEND (Edge Function proxy-ia)
# Chaves de IA NUNCA no frontend. Configurar no Supabase:
#   supabase secrets set GROQ_API_KEY=sua_chave
#   supabase secrets set GEMINI_API_KEY=sua_chave
#   supabase secrets set OPENAI_API_KEY=sua_chave
#   supabase secrets set OPENROUTER_API_KEY=sua_chave
#   supabase secrets set ANTHROPIC_API_KEY=sua_chave
# ============================================================
VITE_AI_PROVIDER=groq

# ============================================================
# EDGE FUNCTION - CRIACAO DE ALOCACOES
# ============================================================
VITE_TMS_EDGE_INTERNAL_TOKEN=tms-internal-token-temporario

# ============================================================
# SEGURANCA (Admin)
# ============================================================
VITE_ADMIN_DELETE_PASSWORD=your-secure-delete-password

# ============================================================
# ZOHO MAIL — OAUTH2
# ============================================================
VITE_ZOHO_CLIENT_ID=1000.xxxxxxxxxxxxxxxx
VITE_ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_ZOHO_ACCOUNT_ID=
VITE_ZOHO_DATA_CENTER=mail.zoho.com
VITE_ZOHO_EMAIL_FROM=contato@conexaoexpress.com.br

# ============================================================
# ZOHO EMAIL (via N8N — legado)
# ============================================================
ZOHO_CLIENT_SECRET=your-zoho-client-secret
