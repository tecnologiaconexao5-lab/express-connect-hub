# ============================================================
# ENV para Edge Function criar-alocacao-escala
# Configure via: supabase secrets set EDGE_SUPABASE_URL=... EDGE_SERVICE_ROLE_KEY=...
# ============================================================

# Supabase URL (pública) — NÃO usar prefixo SUPABASE_ (ignorado pelo CLI)
EDGE_SUPABASE_URL=https://uwrvzsjtpgaifkktpepn.supabase.co

# Service Role Key (NUNCA exposta no frontend)
# Obtenha em: Project Settings > API > service_role key
EDGE_SERVICE_ROLE_KEY=your-service-role-key

# Token interno temporário para proteger a function
# Deve coincidir com o VITE_TMS_EDGE_INTERNAL_TOKEN do .env
TMS_EDGE_INTERNAL_TOKEN=tms-internal-token-temporario
